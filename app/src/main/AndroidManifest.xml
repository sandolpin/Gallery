<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 写真・動画の一覧取得や書き込みに使う権限 -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- 写真の位置情報(EXIF)を読むための権限 -->
    <uses-permission
        android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- 「すべてのファイルへのアクセス」権限。名前変更・移動・回転・削除を
         OSの確認ダイアログなしで行うために使用する。
         Google Play公開時は、審査で用途の説明が必要になる点に注意。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 写真の分析中に、進行状況の通知を出すための権限(Android 13以降は、許可が必要) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 写真の分析を、アプリが閉じていても続けやすくするための権限(WorkManagerのフォアグラウンド) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".data.GalleryApplication"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gallery">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager(裏で動く処理)の自動の準備を止める。
             GalleryApplication の中で、Hiltの工場を使って準備するため。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManagerのフォアグラウンドの種類を、「データの同期・処理」(dataSync)にする。
             Android 14以降は、種類の宣言が必要。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

    </application>

</manifest>
